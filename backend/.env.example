# Backend environment (copy to .env and fill in real values)
PORT=3002

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:password123@localhost:5432/ecommerce_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (use a long random string in production; never commit real values)
JWT_SECRET=change-me-to-a-long-random-string

# CORS
FRONTEND_URL=http://localhost:3000

# Public origin of this API, used to build absolute URLs for uploaded images
# (e.g. http://localhost:3002). Leave unset to derive it from the request host.
# PUBLIC_API_URL=http://localhost:3002

# Payments
# mock = built-in sandbox gateway (dev/CI). A real gateway requires implementing
# PaymentProvider and registering it in PaymentsModule.
PAYMENT_PROVIDER=mock
# HMAC secret used to sign/verify sandbox webhook callbacks (min 16 chars)
PAYMENT_MOCK_SECRET=change-me-to-a-long-random-string
PAYMENT_TTL_MINUTES=30

# Inventory
# Holds on unpaid orders expire after this many minutes
STOCK_RESERVATION_TTL_MINUTES=30
# Products at or below this availability trigger a LOW_STOCK admin notification
LOW_STOCK_THRESHOLD=5

# Rate limiting (applied globally + a stricter budget on auth routes)
# Global: every route accepts up to RATE_LIMIT_MAX requests per RATE_LIMIT_TTL_MS window per client IP.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
# Auth: signup/login/refresh get a much tighter budget (credential-stuffing guard).
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Midtrans Snap (sandbox is free — dashboard.sandbox.midtrans.com)
# To use it, change the single PAYMENT_PROVIDER line above to `midtrans` and
# fill in the two sandbox keys below. Leave it as `mock` to keep the local
# sandbox gateway (no keys needed).
MIDTRANS_SERVER_KEY=SB-Mid-server-your_sandbox_server_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_sandbox_client_key
MIDTRANS_IS_PRODUCTION=false
